{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fitzroy",
  "version": "0.1.0",
  "identifier": "io.github.honeydragoneye.fitzroy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Fitzroy",
        "width": 300,
        "height": 400,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 14
        },
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
